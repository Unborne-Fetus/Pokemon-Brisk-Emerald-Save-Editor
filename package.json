{
  "name": "brisk-dex",
  "productName": "Brisk Dex",
  "version": "1.0.0",
  "description": "Companion app for Pok\u00e9mon Brisk Emerald",
  "main": "main.js",
  "author": "Brisk Emerald",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.briskemerald.briskdex",
    "productName": "Brisk Dex",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
